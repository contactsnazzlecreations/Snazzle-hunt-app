rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true &&
        firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role == "superadmin";
    }

    function hasAdminMfa() {
      return signedIn() && request.auth.token.snazzle_admin_mfa == true;
    }

    match /listen-stories/audio/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin() &&
        request.auth.uid == uid &&
        request.resource.size <= 60 * 1024 * 1024 &&
        request.resource.contentType == "audio/mpeg";
      allow delete: if isSuperAdmin() && request.auth.uid == uid;
    }

    match /listen-stories/images/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin() &&
        request.auth.uid == uid &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
      allow delete: if isSuperAdmin() && request.auth.uid == uid;
    }

    // Centrale Snazzle Bibliotheek voor Special Hunts en later persoonlijke Hunts.
    // Alleen de hoofdbeheerder met bevestigde MFA mag hier afbeeldingen wijzigen.
    match /snazzle-org-assets/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin() && hasAdminMfa() &&
        request.auth.uid == uid &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
      allow delete: if isSuperAdmin() && hasAdminMfa() && request.auth.uid == uid;
    }

    // De Bieb: iedere gebruiker bewaart alleen eigen boekkaften.
    // De foto's zijn niet openbaar doorzoekbaar en maximaal 1 MB per kaft.
    match /bieb/covers/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.size <= 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Alles buiten de specifieke mappen blijft standaard gesloten.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

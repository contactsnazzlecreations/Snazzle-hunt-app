rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return adminExists() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == "superadmin";
    }

    function isVillageAdmin(village) {
      return adminExists() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == "village_admin" &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.village == village;
    }

    function validFinderClose(huntId) {
      return signedIn() &&
        resource.data.found != true &&
        request.resource.data.found == true &&
        request.resource.data.foundByUserId == request.auth.uid &&
        request.resource.data.village == resource.data.village &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["found", "foundAt", "foundByUserId", "foundByNickname"]) &&
        getAfter(/databases/$(database)/documents/findings/$(huntId)).data.userId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/findings/$(huntId)).data.huntId == huntId;
    }

    function ownsShopOrder(orderId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/shopOrders/$(orderId)) &&
        get(/databases/$(database)/documents/shopOrders/$(orderId)).data.userId == request.auth.uid;
    }

    match /adminUsers/{uid} {
      allow read: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == uid);
      allow write: if isSuperAdmin();
    }

    match /villages/{villageId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /hunts/{huntId} {
      allow read: if signedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (
          isVillageAdmin(resource.data.village) &&
          request.resource.data.village == resource.data.village &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["imageUrl", "hint", "foundMessage"])
        ) ||
        validFinderClose(huntId);
    }

    match /findings/{findingId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.huntId == findingId;
      allow read: if isSuperAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isVillageAdmin(resource.data.village);
      allow update, delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(["nickname", "lastSeen"]) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() >= 2 &&
        request.resource.data.nickname.size() <= 20 &&
        request.resource.data.lastSeen is string;
      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /shopProducts/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /shopOrders/{orderId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "userId", "orderNo", "productId", "productName", "unitPriceCents",
          "quantity", "productTotalCents", "fulfillment", "contactName", "email",
          "phone", "street", "houseNumber", "postalCode", "city",
          "adultConfirmed", "privacyAcknowledged", "status", "createdAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.orderNo is string &&
        request.resource.data.productId is string &&
        request.resource.data.productName is string &&
        request.resource.data.unitPriceCents is int &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity >= 1 &&
        request.resource.data.quantity <= 10 &&
        request.resource.data.productTotalCents is int &&
        request.resource.data.fulfillment in ["pickup", "shipping"] &&
        request.resource.data.contactName is string &&
        request.resource.data.contactName.size() >= 2 &&
        request.resource.data.contactName.size() <= 60 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.street is string &&
        request.resource.data.houseNumber is string &&
        request.resource.data.postalCode is string &&
        request.resource.data.city is string &&
        request.resource.data.adultConfirmed == true &&
        request.resource.data.privacyAcknowledged == true &&
        request.resource.data.status == "new" &&
        request.resource.data.createdAt is string &&
        get(/databases/$(database)/documents/shopProducts/$(request.resource.data.productId)).data.active != false &&
        request.resource.data.productName == get(/databases/$(database)/documents/shopProducts/$(request.resource.data.productId)).data.name &&
        request.resource.data.unitPriceCents == get(/databases/$(database)/documents/shopProducts/$(request.resource.data.productId)).data.priceCents &&
        request.resource.data.productTotalCents == request.resource.data.unitPriceCents * request.resource.data.quantity &&
        (
          request.resource.data.fulfillment == "pickup" ||
          (
            request.resource.data.street.size() >= 2 &&
            request.resource.data.houseNumber.size() >= 1 &&
            request.resource.data.postalCode.size() >= 4 &&
            request.resource.data.city.size() >= 2
          )
        );

      allow read: if isSuperAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    match /shopMailConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /mailUsers/{recipientId} {
      allow read: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /mailTemplates/{templateId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /mail/{mailId} {
      allow create: if ownsShopOrder(request.resource.data.orderId) &&
        request.resource.data.keys().hasOnly(["orderId", "kind", "toUids", "to", "replyTo", "template"]) &&
        (
          (
            request.resource.data.kind == "owner" &&
            mailId == request.resource.data.orderId + "-owners" &&
            request.resource.data.toUids == get(/databases/$(database)/documents/shopMailConfig/current).data.recipientUids &&
            request.resource.data.replyTo == get(/databases/$(database)/documents/shopOrders/$(request.resource.data.orderId)).data.email &&
            request.resource.data.template.name == "shop-owner-order"
          ) ||
          (
            request.resource.data.kind == "customer" &&
            mailId == request.resource.data.orderId + "-customer" &&
            request.resource.data.to == [get(/databases/$(database)/documents/shopOrders/$(request.resource.data.orderId)).data.email] &&
            request.resource.data.template.name == "shop-customer-confirmation"
          )
        );
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
